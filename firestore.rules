rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Saved Artifacts
    match /saved_artifacts/{artifactId} {
      function isValidArtifact(data) {
        return data.userId is string &&
               data.prompt is string && data.prompt.size() <= 2000 &&
               data.html is string && data.html.size() <= 1048576 &&
               data.timestamp is timestamp;
      }

      allow create: if isOwner(request.resource.data.userId) &&
                       isValidArtifact(request.resource.data) &&
                       isValidId(artifactId);
      
      allow read: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    // Prompt History
    match /prompt_history/{promptId} {
      function isValidPrompt(data) {
        return data.userId is string &&
               data.prompt is string && data.prompt.size() <= 2000 &&
               data.timestamp is timestamp;
      }

      allow create: if isOwner(request.resource.data.userId) &&
                       isValidPrompt(request.resource.data) &&
                       isValidId(promptId);
      
      allow list, get: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
